{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-freeagent",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-11",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FreeAgentMCP"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AuthStore"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "FreeAgentMCP"
      },
      {
        "name": "AUTH_STORE",
        "class_name": "AuthStore"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0000000000000000000000000000test"
    }
  ],
  "vars": {
    "WORKER_BASE_URL": "http://localhost:8787",
    "FREEAGENT_MODE": "company",
    "FREEAGENT_API_BASE_URL": "https://api.freeagent.com",
    "FREEAGENT_USER_AGENT": "freeagent-mcp/0.1.0"
  },
  "observability": {
    "enabled": true
  }
}
